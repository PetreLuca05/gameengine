/build/
/build-*/
/.toolchain/
/out/
*.spv
/.vs/
/.vscode/
screenshots/
build.log
build-alt.log
/assets/cache/

# Local secrets (Higgsfield API token etc.) - never commit
.env

# vfxgen: downloaded generations (re-creatable from the cache key) and the API call log
/tools/vfxgen/cache/
/tools/vfxgen/logs/
__pycache__/

# Source art: character models and their textures (large, kept out of the repository)
/assets/human/*.fbx
/assets/human/textures/

# Build output / binaries / IDE junk
CMakeFiles/
CMakeCache.txt
*.exe
*.pdb
*.ilk
*.obj
*.lib
*.exp
*.log
.idea/
*.suo
*.user
Thumbs.db
.DS_Store

# vgeo: generated test meshes / builds (re-created by tools/build_vgeo and the tests)
/assets/vgeo/
*.vgeo
/build-agent.log

/.claude/worktrees/

# Packaged builds for playing / comparing (not source)
/openable builds/

# Item authoring scenes (docs/ITEM_PIPELINE.md): build products of assets/src/items/<id>.py
# (tools/blender/build_items.py regenerates them); the scripts are the source.
/assets/src/items/*.blend
/assets/src/items/*.blend1

# Maps tab globe: downloaded source data (tools/globe/build_globe.py re-fetches it)
/tools/globe/cache/
