{
  "_doc": "Supersonic crack: the N-wave of the bullet's shock cone (a finite rise, a linear fall to the under-pressure, back to zero) + a little high ring of the shock reaching the ear.",
  "name": "bullet_crack",
  "params": { "amp": [1, 0, 2], "dur_ms": [0.3, 0.05, 1], "rise_us": [15, 2, 200], "ring": [0.15, 0, 1] },
  "nodes": [
    { "id": "nw", "type": "nwave", "amp": "$amp", "dur_ms": "$dur_ms", "rise_us": "$rise_us" },
    { "id": "hp", "type": "biquad", "mode": "hp", "hz": 150, "in": "nw" },
    { "id": "rn", "type": "noise", "color": "white" },
    { "id": "re", "type": "env", "in": "rn", "stages": [[0.02, 1], [8, 0, 5]], "amp": "$ring" },
    { "id": "rbp", "type": "biquad", "mode": "bp", "hz": 4500, "q": 1.2, "in": "re" },
    { "id": "m", "type": "mix", "in": ["hp", "rbp"] }
  ],
  "out": "m"
}
