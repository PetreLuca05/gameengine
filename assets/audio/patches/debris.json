{
  "_doc": "Debris: an immediate crumble, then the patter of what was thrown up falling back (peaking ~0.2 s after the hit), resonant noise grains whose rate decays.",
  "name": "debris",
  "params": {
    "amp": [
      1,
      0,
      3
    ],
    "rate": [
      200,
      0,
      2000
    ],
    "hz": [
      2500,
      300,
      9000
    ],
    "time": [
      0.8,
      0.1,
      3
    ],
    "decay": [
      5,
      0,
      30
    ]
  },
  "nodes": [
    {
      "id": "g",
      "type": "grains",
      "src": "noise",
      "rate": "$rate",
      "decay": "$decay",
      "hz": "$hz",
      "spread": 0.6,
      "dur_ms": 6,
      "q": 2
