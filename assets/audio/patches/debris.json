    {
      "id": "e",
      "type": "env",
      "in": "g",
      "stages": [
        [
          3,
          0.5,
          0
        ],
        [
          60,
          0.25,
          0
        ],
        [
          150,
          1,
          1
        ],
        [
          700,
          0,
          2
        ]
      ],
