{
  "_doc": "Debris crumble: a grain cloud of resonant noise clicks whose rate decays (chips, grit, glass shards falling).",
  "name": "debris",
  "params": { "amp": [1, 0, 3], "rate": [200, 0, 2000], "hz": [2500, 300, 9000], "time": [0.8, 0.1, 3], "decay": [5, 0, 30] },
  "nodes": [
    { "id": "g", "type": "grains", "src": "noise", "rate": "$rate", "decay": "$decay", "hz": "$hz", "spread": 0.6, "dur_ms": 6, "q": 2 },
    { "id": "e", "type": "env", "in": "g", "stages": [[3, 1, 0], [600, 0, 2]], "time": "$time", "amp": "$amp" }
  ],
  "out": "e"
}
