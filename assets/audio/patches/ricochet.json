{
  "_doc": "Ricochet whine: a sine falling by 'drop' over the flight (the deformed bullet's tone with doppler), tumbling AM, a breath of band-passed noise.",
  "name": "ricochet",
  "params": { "amp": [1, 0, 3], "hz": [3500, 800, 8000], "fm_dev": [1500, 0, 6000], "tumble": [45, 5, 150], "time": [1, 0.3, 3] },
  "nodes": [
    { "id": "sw", "type": "env", "stages": [[0, 0], [420, -1, 1.5]], "time": "$time" },
    { "id": "o", "type": "osc", "wave": "sine", "hz": "$hz", "fm": "$fm_dev", "in": "sw" },
    { "id": "n", "type": "noise", "color": "pink" },
    { "id": "nb", "type": "svf", "mode": "bp", "hz": { "mod": "sw", "scale": 1500, "offset": 2800 }, "q": 3, "in": "n" },
    { "id": "m", "type": "mix", "in": ["o", "nb"], "gains": [0.7, 0.6] },
    { "id": "am", "type": "am", "hz": "$tumble", "depth": 0.5, "in": "m" },
    { "id": "e", "type": "env", "in": "am", "stages": [[2, 1, 0], [400, 0, 3]], "time": "$time", "amp": "$amp" }
  ],
  "out": "e"
}
