{
  "_doc": "Footstep (characters.c chars_take_steps -> game_audio.c): the ground under the foot (material incl. snow / mud / leaves), speed, weight, crouch; water when wading. The recorded layer picks the ground's takes (assets/audio/sample_sources.json); dirt / sand / gravel / water stay synthesized.",
  "name": "footstep",
  "bus": "sfx",
  "priority": 0.3,
  "max_instances": 24,
  "stack_s": 0.0,
  "reverb": 0.8,
  "distance": {
    "min": 1,
    "max": 45,
    "rolloff": 1.2
  },
  "inputs": {
    "material": 1,
    "speed": 3,
    "weight": 80,
    "crouch": 0,
    "water": 0,
    "local": 0,
    "zombie": 0
  },
  "layers": [
    {
      "patch": "footstep",
      "when": "water < 0.5",
      "bind": {
        "material": "material",
        "amp": "clamp(speed / 4, 0.25, 1.5) * (crouch > 0.5 ? 0.45 : 1) * sqrt(weight / 80) * (local > 0.5 ? 0.6 : 1)",
        "gap_ms": "clamp(95 - speed * 11, 35, 95)",
        "contact_ms": "mat_contact(material) * (crouch > 0.5 ? 1.6 : 1) + 0.4",
        "modal": "mat_modes(material) > 0 ? 0.5 : 0",
        "thud": "0.4 + 0.3 * weight / 80",
        "crunch": "material == 9 ? 1 : (material == 17 ? 0.8 : (material == 19 ? 0.6 : (material == 8 ? 0.35 : 0)))",
        "crunch_hz": "material == 17 ? 1300 : (material == 9 ? 3800 : 2500)",
        "crunch_rate": "material == 17 ? 700 : 450",
        "swish": "material == 10 || material == 19 ? 0.6 : (material == 18 ? 0.3 : 0)",
        "lp": "lerp(weight, 60, 9000, 120, 5000)",
        "cloth": "zombie > 0.5 ? 0.06 : clamp(0.06 + speed * 0.03, 0.06, 0.25) * (crouch > 0.5 ? 0.6 : 1)",
        "scuff": "zombie > 0.5 ? 0.45 : 0.04 + 0.02 * speed",
        "scuff_hz": "material == 10 || material == 7 || material == 19 ? 1800 : (material == 9 ? 2600 : 3400)"
      },
      "random": {
        "amp": [
          "db",
          -2,
          2
        ],
        "gap_ms": [
          "mul",
          0.85,
          1.15
        ],
        "crunch_hz": [
          "mul",
          0.85,
          1.15
        ],
        "cloth": [
          "db",
          -4,
          3
        ],
        "scuff": [
          "db",
          -4,
          3
        ]
      }
    },
    {
      "sample": [
        "footstep_hard",
        "footstep_hard",
        "footstep_hard",
        "footstep_hard",
        "footstep_metal",
        "footstep_metal",
        "footstep_wood",
        "",
        "",
        "",
        "footstep_grass",
        "footstep_hard",
        "",
        "",
        "footstep_carpet",
        "footstep_hard",
        "footstep_hard",
        "footstep_snow",
        "footstep_mud",
        "footstep_grass",
        "footstep_metal",
        "footstep_grass"
      ],
      "sample_sel": "material",
      "when": "water < 0.5",
      "gain_db": "sel(material, 0, 0, 0, 0, 12, 12, 3, 0, 0, 0, -12, 0, 0, 0, -17, 0, 0, -11, -20, -12, 12, -12) + (zombie > 0.5 ? -3 : 0)",
      "bind": {
        "amp": "clamp(speed / 4, 0.3, 1.4) * (crouch > 0.5 ? 0.45 : 1) * sqrt(weight / 80) * (local > 0.5 ? 0.6 : 1)",
        "pitch": "lerp(weight, 60, 1.05, 120, 0.92) * (crouch > 0.5 ? 1.04 : 1)"
      },
      "random": {
        "amp": [
          "db",
          -2.5,
          2.5
        ]
      },
      "pitch": [
        0.95,
        1.05
      ]
    },
    {
      "patch": "splash",
      "when": "water > 0.5",
      "bind": {
        "amp": "clamp(speed / 4, 0.3, 1.2)",
        "size": "0.7",
        "bubbles": "40"
      }
    }
  ]
}
