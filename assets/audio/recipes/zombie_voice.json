{
  "_doc": "Zombie calls (game_audio.c): call 0 groan, 1 growl, 2 scream, 3 attack bark. 'pitch' and 'tract' are per zombie (from its entity id: the same zombie keeps its voice on every machine), 'rough' its rasp.",
  "name": "zombie_voice",
  "bus": "voice", "priority": 0.55, "max_instances": 8, "stack_s": 0.0,
  "distance": { "min": 2, "max": 70, "rolloff": 1 },
  "inputs": { "call": 0, "pitch": 1, "tract": 1, "rough": 0.5 },
  "layers": [
    { "patch": "zombie_voice", "bind": {
        "f0": "sel(call, 70, 55, 210, 120) * pitch",
        "open": "sel(call, 0.65, 0.55, 0.45, 0.5)",
        "jitter": "sel(call, 0.04, 0.08, 0.05, 0.07) * (0.6 + rough)",
        "shimmer": "sel(call, 0.15, 0.3, 0.2, 0.25) * (0.6 + rough)",
        "fry": "sel(call, 0.35, 0.85, 0.1, 0.5)",
        "fry_hz": "sel(call, 26, 34, 40, 30)",
        "breath": "sel(call, 0.15, 0.3, 0.5, 0.3)",
        "shift": "tract * sel(call, 1, 0.95, 1.1, 1)",
        "rasp": "sel(call, 1.6, 3, 4, 3) * (0.7 + rough)",
        "time": "sel(call, 1.6, 1.0, 1.3, 0.5)",
        "amp": "sel(call, 0.6, 0.8, 1.0, 0.9)"
      },
      "random": { "time": ["mul", 0.8, 1.25], "f0": ["mul", 0.92, 1.08] } }
  ]
}
