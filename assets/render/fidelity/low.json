{
  "level": "low",
  "name": "Low",
  "description": "The minimum that still looks like the game: FXAA, tiny bloom, two hard shadow cascades, distance fog, 0.66 render scale, unlit particles.",
  "budget_ms": 5.0,
  "post": true,
  "features": {
    "aa": {"avail": "on", "default": 1, "max": 1},
    "upscaler": {"avail": "off", "allowed": [0, 2]},
    "upscale_ratio": {"avail": "on", "default": 0.67},
    "render_scale": {"avail": "on", "default": 0.66, "min": 0.5, "max": 1.0},
    "sharpen": {"avail": "off", "max": 1},
    "ao": {"avail": "no"},
    "contact_shadows": {"avail": "no"},
    "ssr": {"avail": "no"},
    "ssgi": {"avail": "no"},
    "puddle_reflections": {"avail": "no"},
    "volumetrics": {"avail": "no"},
    "vol_local_lights": {"avail": "no"},
    "motion_blur": {"avail": "no"},
    "dof": {"avail": "no"},
    "dof_quality": {"avail": "on", "default": 0, "max": 0},
    "ads_dof": {"avail": "no"},
    "bloom": {"avail": "on"},
    "bloom_quality": {"avail": "on", "default": 0, "max": 0},
    "chromatic": {"avail": "no"},
    "vignette": {"avail": "on", "default": 0.25},
    "film_grain": {"avail": "off", "max": 1},
    "hdr_output": {"avail": "no"},
    "shadows": {"avail": "on", "default": 1, "max": 1, "min": 1},
    "shadow_resolution": {"avail": "on", "default": 1, "max": 1},
    "shadow_projection": {"avail": "on", "default": 1, "allowed": [0, 1]},
    "shadow_cascades": {"avail": "on", "default": 2, "allowed": [1, 2]},
    "soft_shadow_quality": {"avail": "on", "default": 0, "max": 0},
    "shadow_min_radius": {"avail": "on", "default": 0.5, "min": 0.5},
    "shadow_caster_limit": {"avail": "on", "default": 2, "min": 2},
    "shadow_far_interval": {"avail": "on", "default": 2, "min": 2},
    "light_shadow_quality": {"avail": "on", "default": 1, "max": 1},
    "texture_quality": {"avail": "on", "default": 0, "max": 0},
    "aniso": {"avail": "on", "default": 2, "allowed": [1, 2, 4]},
    "vgeo_shadow_error_px": {"avail": "on", "scale": 3},
    "foliage_wind": {"avail": "on", "default": 1, "max": 1},
    "terrain_quality": {"avail": "on", "default": 1, "max": 1},
    "scope_pip_scale": {"avail": "on", "default": 0.6, "max": 0.75},
    "vfx_quality": {"avail": "on", "default": 0, "max": 0},
    "vfx_lighting": {"avail": "no"},
    "precip_quality": {"avail": "on", "default": 1, "allowed": [1]},
    "water": {"avail": "on", "default": 0, "max": 0}
  },
  "eras": {
    "2015": {
      "shadows": {"avail": "on", "default": 2, "max": 2, "note": "2015 / 2010 eras: cheaper geometry pays for soft shadows (Hard and Soft, soft quality Low)", "min": 1}
    },
    "2010": {
      "aa": {"avail": "on", "default": 2, "max": 2, "note": "2010-era Low: SMAA (MLAA era) fits the budget"},
      "shadows": {"avail": "on", "default": 2, "max": 2, "min": 1}
    }
  }
}
