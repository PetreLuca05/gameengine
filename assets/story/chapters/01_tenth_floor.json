    ]},
    {"id": "knock_timeout", "arm": {"objective": "knock", "state": "active"}, "when": false, "fallback": 75, "do": [{"objective": "knock", "set": "done"}]},

    {"id": "decide_timeout", "arm": {"objective": "decide", "state": "active"}, "when": false, "fallback": 90, "do": [
