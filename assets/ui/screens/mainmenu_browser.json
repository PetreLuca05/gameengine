    { "id": "sources", "parent": "main", "h": "@mm_source_h" },
    { "id": "filters", "parent": "main", "h": "@mm_filter_h", "dir": "row", "align": "stretch", "gap": "@mm_gap" },
    { "id": "f_map", "parent": "filters", "w": "@mm_filter_w" },
