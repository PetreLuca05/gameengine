    { "id": "f_refresh", "parent": "filters", "w": "@mm_button_w" },
    { "id": "list", "parent": "main", "flex": 1 },
    { "id": "detail", "parent": "root", "w": "@mm_detail_w", "dir": "column", "align": "stretch", "gap": "@mm_gap" },
    { "id": "d_thumb", "parent": "detail", "aspect": 1.7778 },
    { "id": "d_info", "parent": "detail", "flex": 1 },
