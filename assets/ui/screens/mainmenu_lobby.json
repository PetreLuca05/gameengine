{
  "_doc": "Lobby (replaces the tab content while in a lobby): players | map + game settings | chat, the action bar at the bottom.",
  "nodes": [
    { "id": "root", "dir": "column", "align": "stretch", "gap": "@mm_gap" },
    { "id": "main", "parent": "root", "flex": 1, "dir": "row", "align": "stretch", "gap": "@mm_gap_lg" },
    { "id": "players", "parent": "main", "w": "@lb_side_w" },
    { "id": "center", "parent": "main", "flex": 1 },
    { "id": "chat", "parent": "main", "w": "@lb_chat_w" },
    { "id": "bar", "parent": "root", "h": "@lb_bar_h", "dir": "row", "align": "stretch", "gap": "@mm_gap" },
    { "id": "ready", "parent": "bar", "w": "@lb_button_w" },
    { "id": "start", "parent": "bar", "w": "@lb_button_w" },
    { "id": "invite", "parent": "bar", "w": "@lb_button_w" },
    { "id": "status", "parent": "bar", "flex": 1 },
    { "id": "leave", "parent": "bar", "w": "@lb_button_w" }
  ]
}
