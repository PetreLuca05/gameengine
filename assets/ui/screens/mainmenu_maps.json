    { "id": "spacer", "parent": "main", "flex": 1 },
    { "id": "bar", "parent": "main", "h": "@mm_map_row_h", "dir": "row", "align": "stretch", "gap": "@mm_gap_lg" },
    { "id": "group0", "parent": "bar", "w": "@mm_list_w" },
    { "id": "group1", "parent": "bar", "w": "@mm_list_w" },
    { "id": "detail", "parent": "root", "w": "@mm_detail_wide" }
