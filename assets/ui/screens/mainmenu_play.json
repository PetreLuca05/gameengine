{
  "_doc": "Play tab: the button stack bottom left (like the pause menu), the party panel on the right (the lock, the players, the map, the game settings). 'leave' shows only in someone else's party.",
  "nodes": [
    { "id": "root" },
    { "id": "stack", "parent": "root", "anchor": "bottom_left", "dir": "column", "align": "stretch", "w": "@mm_side_w", "gap": "@mm_gap_sm" },
    { "id": "title", "parent": "stack", "h": "@mm_title_h", "label": "Play" },
    { "id": "continue", "parent": "stack", "h": "@mm_item_h", "label": "Continue", "action": "continue" },
    { "id": "story", "parent": "stack", "h": "@mm_item_h", "label": "Story: 10th Floor", "action": "story" },
    { "id": "start", "parent": "stack", "h": "@mm_item_h", "label": "Start game", "action": "start" },
    { "id": "join", "parent": "stack", "h": "@mm_item_h", "label": "Join", "action": "join" },
    { "id": "leave", "parent": "stack", "h": "@mm_item_h", "label": "Leave party", "action": "leave" },
    { "id": "side", "parent": "root", "anchor": "right", "w": "@mm_panel_w", "h_pct": 1.0, "max_h": "@mm_panel_max_h" }
  ]
}
