#version 450
// Bloom upsample: 3x3 tent of the coarser up-mip added to this level's down-mip (progressive
// accumulation; the tonemapper divides by the mip count). pc.u0.x = destination mip.
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D down_mip;
layout(set = 0, binding = 1) uniform sampler2D coarse_mip;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D dst;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(sz);
    vec2 t = 1.0 / vec2(textureSize(coarse_mip, 0));
    vec3 s = textureLod(coarse_mip, uv + t * vec2(-1, -1), 0.0).rgb + textureLod(coarse_mip, uv + t * vec2(1, -1), 0.0).rgb +
             textureLod(coarse_mip, uv + t * vec2(-1, 1), 0.0).rgb + textureLod(coarse_mip, uv + t * vec2(1, 1), 0.0).rgb;
    s += 2.0 * (textureLod(coarse_mip, uv + t * vec2(0, -1), 0.0).rgb + textureLod(coarse_mip, uv + t * vec2(-1, 0), 0.0).rgb +
                textureLod(coarse_mip, uv + t * vec2(1, 0), 0.0).rgb + textureLod(coarse_mip, uv + t * vec2(0, 1), 0.0).rgb);
    s += 4.0 * textureLod(coarse_mip, uv, 0.0).rgb;
    s /= 16.0;
    imageStore(dst, p, vec4(textureLod(down_mip, uv, 0.0).rgb + s, 1.0));
}
