#version 450
// Depth -> R32F history (TAA / temporal disocclusion tests next frame).
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D depth_tex;
layout(set = 0, binding = 8, r32f) uniform writeonly image2D dst;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ds = imageSize(dst);
    if (p.x >= ds.x || p.y >= ds.y) return;
    imageStore(dst, p, vec4(texelFetch(depth_tex, p, 0).r));
}
