#version 450
// Depth of field gather (half resolution, "scatter as gather"): a kernel of 16 / 32 / 48 taps (r_dof_quality)
// (golden-angle disk, or a hexagon when s_dof2.y = 1) spanning the maximum CoC. A tap counts
// when its own CoC covers the distance to the centre.
//   far field:  limited by the centre's CoC as well, so blurred background never bleeds over a
//               sharper foreground.
//   near field: foreground blur spreads over everything; written with a coverage alpha.
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D half_tex;   // rgb colour, a signed CoC (half px)
layout(set = 0, binding = 1) uniform sampler2D noise_tex;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D far_out;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D near_out;

vec2 hexify(vec2 d) {
    // Map a unit-disk direction onto a hexagon of the same circumradius.
    float a = atan(d.y, d.x);
    float seg = PI / 3.0;
    float t = mod(a + seg * 0.5, seg) - seg * 0.5;
    return d * (cos(seg * 0.5) / cos(t));
}
float coverage(float coc, float dist) { return clamp(coc - dist + 1.0, 0.0, 1.0); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(far_out);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 texel = 1.0 / vec2(sz);
    vec2 uv = (vec2(p) + 0.5) * texel;
    vec4 c = textureLod(half_tex, uv, 0.0);
    float R = max(U.s_dof.w * 0.5, 1.0);
    float rot = blue_noise(noise_tex, p).r * 2.0 * PI;
    float cfar = max(c.a, 0.0);
    vec3 far_sum = c.rgb;
    float far_w = 1.0;
    vec3 near_sum = vec3(0.0);
    float near_w = 0.0;
    bool hex = U.s_dof2.y > 0.5;
    int N = pc.u0.x > 0u ? int(pc.u0.x) : 48;   // r_dof_quality: 16 gaussian-like disk, 32 hybrid, 48 bokeh
    for (int i = 0; i < N; i++) {
        float r = sqrt((float(i) + 0.5) / float(N));
        float a = float(i) * 2.39996323 + rot;
        vec2 d = vec2(cos(a), sin(a)) * r;
        if (hex) d = hexify(d);
        float dist = length(d) * R;
        vec4 s = textureLod(half_tex, uv + d * R * texel, 0.0);
        if (s.a >= 0.0) {
            float w = coverage(min(s.a, cfar), dist);
            far_sum += s.rgb * w;
            far_w += w;
        } else {
            float w = coverage(-s.a, dist);
            near_sum += s.rgb * w;
            near_w += w;
        }
    }
    // Near coverage: fraction of the kernel the foreground actually covers.
    float alpha = clamp(near_w * 3.0 / float(N), 0.0, 1.0);
    if (c.a < -0.5) alpha = max(alpha, clamp(-c.a - 0.5, 0.0, 1.0));
    imageStore(far_out, p, vec4(far_sum / far_w, cfar));
    imageStore(near_out, p, vec4(near_w > 1e-3 ? near_sum / near_w : c.rgb, alpha));
}
