#version 450
// Lens flare (quarter resolution, screen-space, from the bloom chain): thresholded on the exposed
// colour, then ghosts mirrored through the centre with chromatic offsets, a halo ring and an
// anamorphic horizontal streak. Written back in scene units (divided by the exposure) so the
// tonemapper treats it like the bloom.
//   s_lens.x flare intensity, s_lens.y anamorphic intensity.
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D bloom_tex;   // a mid bloom mip (quarter res)
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D dst;
layout(std430, set = 0, binding = 13) readonly buffer Exposure { float e[16]; } X;

vec3 bright(vec2 uv, float expo) {
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec3(0.0);
    vec3 c = textureLod(bloom_tex, uv, 0.0).rgb * expo;
    return max(c - vec3(1.0), vec3(0.0));
}
vec3 chroma(vec2 uv, vec2 dir, float amt, float expo) {
    return vec3(bright(uv + dir * amt, expo).r, bright(uv, expo).g, bright(uv - dir * amt, expo).b);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(sz);
    float expo = max(X.e[0], 1e-6);
    vec3 r = vec3(0.0);
    if (U.s_lens.x > 0.0) {
        vec2 g = vec2(1.0) - uv;
        vec2 dir = (vec2(0.5) - g) * 0.37;
        for (int i = 0; i < 5; i++) {
            vec2 o = g + dir * float(i);
            float w = pow(1.0 - clamp(length(vec2(0.5) - o) / 0.7071, 0.0, 1.0), 6.0);
            vec3 tint = mix(vec3(1.0, 0.75, 0.55), vec3(0.55, 0.75, 1.0), float(i) / 4.0);
            r += chroma(o, normalize(dir + 1e-5) * 0.004, 1.0, expo) * w * tint;
        }
        vec2 hd = normalize(vec2(0.5) - g + 1e-5) * 0.45;
        float hw = pow(1.0 - clamp(length(vec2(0.5) - fract(g + hd)) / 0.7071, 0.0, 1.0), 5.0);
        r += chroma(g + hd, hd * 0.02, 1.0, expo) * hw * 0.6;
        r *= U.s_lens.x;
    }
    if (U.s_lens.y > 0.0) {
        vec3 a = vec3(0.0);
        float t = 1.0 / float(sz.x);
        for (int i = -16; i <= 16; i++) {
            float w = exp(-abs(float(i)) * 0.18);
            a += bright(uv + vec2(float(i) * t * 6.0, 0.0), expo) * w;
        }
        r += a * vec3(0.35, 0.55, 1.0) * (U.s_lens.y * 0.15);
    }
    imageStore(dst, p, vec4(r / expo, 1.0));
}
