#version 450
// AMD FidelityFX Super Resolution 1.0 - EASU (edge-adaptive spatial upsampling), render ->
// output resolution (third_party/fsr, MIT). EASU wants a perceptual input: the HDR colour is
// mapped through an invertible per-channel x / (1 + x) in the fetch callbacks and back after.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D color_tex;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform Push { uvec4 con0, con1, con2, con3; } pc;
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_EASU_F 1
AF4 tm(AF4 v) { return v / (1.0 + v); }
AF4 FsrEasuRF(AF2 p) { return tm(textureGather(color_tex, p, 0)); }
AF4 FsrEasuGF(AF2 p) { return tm(textureGather(color_tex, p, 1)); }
AF4 FsrEasuBF(AF2 p) { return tm(textureGather(color_tex, p, 2)); }
#include "ffx_fsr1.h"
void main() {
    AU2 gxy = AU2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (int(gxy.x) >= sz.x || int(gxy.y) >= sz.y) return;
    AF3 c;
    FsrEasuF(c, gxy, pc.con0, pc.con1, pc.con2, pc.con3);
    c = clamp(c, AF3(0.0), AF3(0.999));
    imageStore(dst, ivec2(gxy), vec4(c / (1.0 - c), 1.0));
}
