#version 450
// Hi-Z pyramid (closest depth = min, depth 0 = near): mip 0 from the depth buffer, every next mip
// the min of the 2x2 (+ the odd edge row / column) of the previous one. pc.u0.x = destination mip.
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D depth_tex;
layout(set = 0, binding = 8, r32f) uniform readonly image2D src;
layout(set = 0, binding = 9, r32f) uniform writeonly image2D dst;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ds = imageSize(dst);
    if (p.x >= ds.x || p.y >= ds.y) return;
    if (pc.u0.x == 0u) {
        imageStore(dst, p, vec4(texelFetch(depth_tex, p, 0).r));
        return;
    }
    ivec2 ss = imageSize(src);
    ivec2 b = p * 2;
    float d = imageLoad(src, min(b, ss - 1)).r;
    d = min(d, imageLoad(src, min(b + ivec2(1, 0), ss - 1)).r);
    d = min(d, imageLoad(src, min(b + ivec2(0, 1), ss - 1)).r);
    d = min(d, imageLoad(src, min(b + ivec2(1, 1), ss - 1)).r);
    // Odd source sizes: fold in the extra column / row.
    if ((ss.x & 1) != 0 && p.x == ds.x - 1) { d = min(d, imageLoad(src, min(b + ivec2(2, 0), ss - 1)).r); d = min(d, imageLoad(src, min(b + ivec2(2, 1), ss - 1)).r); }
    if ((ss.y & 1) != 0 && p.y == ds.y - 1) { d = min(d, imageLoad(src, min(b + ivec2(0, 2), ss - 1)).r); d = min(d, imageLoad(src, min(b + ivec2(1, 2), ss - 1)).r); }
    imageStore(dst, p, vec4(d));
}
