#version 450
// Lens droplets: refract the image through the drop map (lens_drops.comp). Inside a drop the
// view is a small inverted, blurred lens of the scene around it; the rim darkens a little and a
// highlight from the sky sits on the upper side. pc.p0.x = strength (0..1).
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D color_tex;
layout(set = 0, binding = 1) uniform sampler2D drop_map;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D dst;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(sz);
    vec3 c = textureLod(color_tex, uv, 0.0).rgb;
    vec4 d = textureLod(drop_map, uv, 0.0);
    float k = pc.p0.x;
    if (d.z > 0.001 && k > 0.0) {
        float h = d.z;
        vec2 off = -d.xy * 0.06 * h + vec2(0.0, 0.015) * h;
        vec2 t = 1.0 / vec2(sz);
        vec3 r = vec3(0.0);
        // A little blur inside the drop (water + defocus).
        for (int i = 0; i < 4; i++) {
            vec2 o = vec2((i & 1) == 0 ? -1.5 : 1.5, (i & 2) == 0 ? -1.5 : 1.5) * t * (1.0 + h * 2.0);
            r += textureLod(color_tex, clamp(uv + off + o, vec2(0.0), vec2(1.0)), 0.0).rgb;
        }
        r *= 0.25;
        float rim = smoothstep(0.35, 0.0, h);
        r *= 1.0 - rim * 0.35;
        // Highlight: the drop's normal facing up-left catches the sky.
        vec3 n = normalize(vec3(-d.x, -d.y, 1.0));
        float spec = pow(max(dot(n, normalize(vec3(-0.4, 0.6, 0.7))), 0.0), 40.0);
        r += vec3(spec) * 0.6 * U.sky.w * (luma(c) + 0.2);
        c = mix(c, r, clamp(d.w * k, 0.0, 1.0));
    }
    imageStore(dst, p, vec4(sanitize(c), 1.0));
}
