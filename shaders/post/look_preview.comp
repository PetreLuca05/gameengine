#version 450
// Look preview strip (Settings > Look, docs/LOOKS.md): the current scene graded by each look, one
// tile per look side by side (LookId order), sRGB-encoded RGBA8 for the UI. Source: the exposed
// pre-tonemap colour (or the lit HDR with the fixed exposure at Engine Fidelity Off); 4 bilinear taps
// per texel so the minified scene does not shimmer. Grade only (no bloom / vignette / grain).
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
#include "look.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D color_tex;
layout(set = 0, binding = 1) uniform sampler3D lut0;
layout(set = 0, binding = 2) uniform sampler3D lut1;
layout(set = 0, binding = 3) uniform sampler3D lut2;
layout(set = 0, binding = 4) uniform sampler3D lut3;
layout(set = 0, binding = 5) uniform sampler3D lut4;
layout(set = 0, binding = 8, rgba8) uniform writeonly image2D dst;
layout(std430, set = 0, binding = 13) readonly buffer Exposure { float e[16]; } X;
// pc.u0.x tiles, u0.y tile width (px), u0.z Fidelity Off (exposure in p0.x)

vec3 srgb_encode(vec3 c) { return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    int tw = max(int(pc.u0.y), 1);
    int tile = min(p.x / tw, int(pc.u0.x) - 1);
    vec2 tuv = (vec2(float(p.x - tile * tw), float(p.y)) + 0.5) / vec2(float(tw), float(sz.y));
    vec2 dt = 0.25 / vec2(float(tw), float(sz.y));
    vec3 c = sanitize(textureLod(color_tex, tuv + vec2(-dt.x, -dt.y), 0.0).rgb) + sanitize(textureLod(color_tex, tuv + vec2(dt.x, -dt.y), 0.0).rgb) +
             sanitize(textureLod(color_tex, tuv + vec2(-dt.x, dt.y), 0.0).rgb) + sanitize(textureLod(color_tex, tuv + vec2(dt.x, dt.y), 0.0).rgb);
    float expo = pc.u0.z != 0u ? pc.p0.x : (X.e[0] > 0.0 ? X.e[0] : 1.0);
    c *= 0.25 * expo;
    vec3 o;
    if (tile == 0) o = look_lut(lut0, c);
    else if (tile == 1) o = look_lut(lut1, c);
    else if (tile == 2) o = look_lut(lut2, c);
    else if (tile == 3) o = look_lut(lut3, c);
    else o = look_lut(lut4, c);
    imageStore(dst, p, vec4(srgb_encode(clamp(o, 0.0, 1.0)), 1.0));
}
