#version 450
// HUD phone panel (src/render/phone_view.c, docs/PHONE.md): the phone's screen image (display
// linear, the UI composited) box-filtered down to the panel's pixel size so text and thin lines
// stay clean at ~22 % of the screen height, sRGB-encoded for the UI pass, with a rounded-corner
// alpha mask (1 px anti-aliased).
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D screen_tex;
layout(set = 0, binding = 8, rgba8) uniform writeonly image2D dst_panel;
// pc.p0: x corner radius (panel pixels)

vec3 srgb_encode(vec3 c) { return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst_panel);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 src = vec2(textureSize(screen_tex, 0));
    vec2 k = src / vec2(sz);                       // source texels per panel pixel
    int n = int(clamp(ceil(max(k.x, k.y)), 1.0, 8.0));
    vec3 acc = vec3(0.0);
    for (int y = 0; y < n; y++)
        for (int x = 0; x < n; x++) {
            vec2 uv = (vec2(p) + (vec2(x, y) + 0.5) / float(n)) / vec2(sz);
            acc += textureLod(screen_tex, uv, 0.0).rgb;
        }
    vec3 c = acc / float(n * n);
    float r = pc.p0.x;
    vec2 q = abs(vec2(p) + 0.5 - vec2(sz) * 0.5) - (vec2(sz) * 0.5 - r);
    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
    imageStore(dst_panel, p, vec4(srgb_encode(clamp(c, 0.0, 1.0)), clamp(0.5 - d, 0.0, 1.0)));
}
