#version 450
// Screen-space diffuse GI (Ultra): one cosine-weighted ray per half-res pixel per frame (blue noise
// rotated), linear screen-space march against the depth buffer, radiance from the previous
// frame's colour at the reprojected hit (one bounce per frame, more bounces accumulate over time).
// Output: rgb irradiance estimate (temporally accumulated + upsampled, added to the ambient term).
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D depth_tex;
layout(set = 0, binding = 1) uniform sampler2D normal_tex;
layout(set = 0, binding = 2) uniform sampler2D material_tex;
layout(set = 0, binding = 3) uniform sampler2D color_prev;
layout(set = 0, binding = 4) uniform sampler2D velocity_tex;
layout(set = 0, binding = 5) uniform sampler2D noise_tex;
layout(set = 0, binding = 8) uniform writeonly image2D dst;
vec3 to_screen(vec3 v) {
    vec4 c = U.proj * vec4(v, 1.0);
    vec3 n = c.xyz / c.w;
    return vec3((n.xy + U.jitter.xy) * 0.5 + 0.5, n.z);
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(sz);
    float d = textureLod(depth_tex, uv, 0.0).r;
    vec4 mat = textureLod(material_tex, uv, 0.0);
    if (d >= 1.0 || (gb_flags(mat) & (GB_VIEWMODEL | GB_UNLIT)) != 0u) { imageStore(dst, p, vec4(0.0)); return; }
    vec3 vp = view_pos(uv, d);
    vec3 N = normalize((U.view * vec4(oct_decode(textureLod(normal_tex, uv, 0.0).rg), 0.0)).xyz);
    vec4 nz = blue_noise(noise_tex, p);
    // Cosine-weighted direction around N.
    float phi = 2.0 * PI * nz.x, r = sqrt(nz.y);
    vec3 up = abs(N.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tx = normalize(cross(up, N)), ty = cross(N, tx);
    vec3 dirv = normalize(tx * (r * cos(phi)) + ty * (r * sin(phi)) + N * sqrt(max(0.0, 1.0 - nz.y)));
    const int STEPS = 16;
    float max_dist = 6.0;
    vec3 acc = vec3(0.0);
    vec3 o = vp + N * 0.02;
    for (int i = 1; i <= STEPS; i++) {
        float t = (float(i) - 1.0 + nz.z) / float(STEPS);
        t = t * t * max_dist;
        vec3 sp = o + dirv * t;
        if (sp.z > -U.depthp.x) break;
        vec3 s = to_screen(sp);
        if (any(lessThan(s.xy, vec2(0.0))) || any(greaterThan(s.xy, vec2(1.0)))) break;
        float scene = linear_depth(textureLod(depth_tex, s.xy, 0.0).r), ray_z = -sp.z;
        if (ray_z > scene && ray_z - scene < 0.25 + t * 0.15) {
            vec2 puv = s.xy - textureLod(velocity_tex, s.xy, 0.0).rg;
            acc = min(textureLod(color_prev, puv, 1.0).rgb, vec3(16.0));
            break;
        }
    }
    imageStore(dst, p, vec4(acc, 1.0));
}
