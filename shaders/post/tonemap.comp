#version 450
// Tonemap + grade (output resolution). Linear HDR in, display-linear out:
//   SDR:    Rec.709 linear 0..1 (final.frag: CAS, grain, dither, sRGB encode)
//   HDR10:  Rec.2020 linear, nits / 10000 (final.frag: PQ encode)
// Order: lens distortion + chromatic aberration -> bloom (energy conserving mix) + dirt + flare ->
// exposure -> vignette -> white balance -> contrast / saturation -> feedback (damage, low health,
// underwater, night vision, desaturate, tint) -> tonemapper (ACES fit, AgX, Khronos PBR Neutral)
// -> lift / gamma / gain -> 3D LUT -> colour-blind correction -> brightness / gamma -> flash.
// With a Look (docs/LOOKS.md, s_look.x) the tonemapper is the look's baked LUT (binding 7: its whole
// grade, look.glsl); the look also sets the bloom threshold / tint, halation, letterbox and the
// damage / low-health colours.
// Split compare (s_dbg.y): the left half shows the raw lit HDR, only exposed and tonemapped.
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D color_tex;
layout(set = 0, binding = 1) uniform sampler2D bloom_tex;
layout(set = 0, binding = 2) uniform sampler2D flare_tex;
layout(set = 0, binding = 3) uniform sampler2D dirt_tex;
layout(set = 0, binding = 4) uniform sampler3D lut_tex;
layout(set = 0, binding = 5) uniform sampler2D noise_tex;
layout(set = 0, binding = 6) uniform sampler2D compare_tex;
layout(set = 0, binding = 7) uniform sampler3D look_tex;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D dst;
layout(std430, set = 0, binding = 13) readonly buffer Exposure { float e[16]; } X;
// pc.u0.x bloom present, u0.y flare present, u0.z bloom mip count, u0.w compare source present

// ---------------------------------------------------------------- tonemappers
const mat3 ACES_IN = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
const mat3 ACES_OUT = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
vec3 aces_fit(vec3 v) {
    v = ACES_IN * v;
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return clamp(ACES_OUT * (a / b), 0.0, 1.0);
}
// AgX (Troy Sobotka), minimal fit by Benjamin Wrensch; base look.
const mat3 AGX_IN = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051, 0.0784335999999992, 0.878468636469772, 0.0784336,
                         0.0792237451477643, 0.0791661274605434, 0.879142973793104);
const mat3 AGX_OUT = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438, -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
                          -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
vec3 agx_curve(vec3 x) {
    vec3 x2 = x * x, x4 = x2 * x2;
    return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
}
vec3 agx(vec3 v) {
    const float lo = -12.47393, hi = 4.026069;
    v = AGX_IN * max(v, vec3(1e-10));
    v = clamp(log2(v), lo, hi);
    v = (v - lo) / (hi - lo);
    v = agx_curve(v);
    v = AGX_OUT * v;
    return clamp(pow(max(v, vec3(0.0)), vec3(2.2)), 0.0, 1.0);
}
// Khronos PBR Neutral (reference implementation).
vec3 pbr_neutral(vec3 c) {
    const float start = 0.8 - 0.04, desat = 0.15;
    float x = min(c.r, min(c.g, c.b));
    float off = x < 0.08 ? x - 6.25 * x * x : 0.04;
    c -= off;
    float peak = max(c.r, max(c.g, c.b));
    if (peak < start) return c;
    const float d = 1.0 - start;
    float np = 1.0 - d * d / (peak + d - start);
    c *= np / peak;
    float g = 1.0 - 1.0 / (desat * (peak - np) + 1.0);
    return mix(c, vec3(np), g);
}
vec3 tonemap(vec3 c) {
    int t = int(U.s_tm.x + 0.5);
    if (t == 0) return aces_fit(c);
    if (t == 1) return agx(c);
    return clamp(pbr_neutral(c), 0.0, 1.0);
}

// ---------------------------------------------------------------- grading helpers
vec3 srgb_encode(vec3 c) { return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c)); }
vec3 srgb_decode(vec3 c) { return mix(c / 12.92, pow((max(c, vec3(0.0)) + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c)); }

vec3 white_balance(vec3 c, float temp, float tint) {
    if (abs(temp) < 1e-4 && abs(tint) < 1e-4) return c;
    float t1 = temp * 10.0 / 6.0, t2 = tint * 10.0 / 6.0;
    float x = 0.31271 - t1 * (t1 < 0.0 ? 0.1 : 0.05);
    float y = 2.87 * x - 3.0 * x * x - 0.27509507 + t2 * 0.05;
    vec3 xyz = vec3(x / y, 1.0, (1.0 - x - y) / y);
    vec3 w2 = vec3(0.7328 * xyz.x + 0.4296 * xyz.y - 0.1624 * xyz.z, -0.7036 * xyz.x + 1.6975 * xyz.y + 0.0061 * xyz.z,
                   0.0030 * xyz.x + 0.0136 * xyz.y + 0.9834 * xyz.z);
    vec3 bal = vec3(0.949237, 1.03542, 1.08728) / w2;
    const mat3 TO_LMS = mat3(3.90405e-1, 5.49941e-1, 8.92632e-3, 7.08416e-2, 9.63172e-1, 1.35775e-3, 2.31082e-2, 1.28021e-1, 9.36245e-1);
    const mat3 FROM_LMS = mat3(2.85847e+0, -1.62879e+0, -2.48910e-2, -2.10182e-1, 1.15820e+0, 3.24281e-4, -4.18120e-2, -1.18169e-1, 1.06867e+0);
    vec3 lms = c * TO_LMS;   // row-vector form of the (row-major) reference matrices
    lms *= bal;
    return max(lms * FROM_LMS, vec3(0.0));
}

#include "colorblind.glsl"
#include "look.glsl"

const mat3 REC709_TO_2020 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(sz);
    float expo = X.e[0] > 0.0 ? X.e[0] : 1.0;
    float aspect = U.misc.w;
    float time = U.cam_pos.w;
    bool hdr = U.s_out.x > 0.5;

    if (U.s_dbg.y > 0.5 && uv.x < 0.5 && pc.u0.w != 0u) {
        // A/B split: raw lit scene, exposure + tonemap only.
        vec3 r = tonemap(textureLod(compare_tex, uv, 0.0).rgb * expo);
        if (hdr) r = REC709_TO_2020 * r * (U.s_out.y / 10000.0);
        if (abs(uv.x - 0.5) * float(sz.x) < 1.5) r = vec3(hdr ? 0.02 : 1.0);
        imageStore(dst, p, vec4(r, 1.0));
        return;
    }

    // Lens distortion (barrel / pincushion) + underwater wobble.
    vec2 d = uv - 0.5;
    d.x *= aspect;
    float r2 = dot(d, d);
    vec2 suv = uv;
    float k = U.s_lens2.x * 0.15;
    if (abs(k) > 1e-5) suv = 0.5 + (uv - 0.5) * (1.0 + k * r2) / (1.0 + k * 0.25 * (aspect * aspect + 1.0));
    float uw = U.s_fb2.y;
    if (uw > 0.0) suv += uw * 0.0035 * vec2(sin(uv.y * 40.0 + time * 2.3), cos(uv.x * 34.0 + time * 1.9));
    // Chromatic aberration (radial), boosted by hit markers and sprint.
    float ca = (U.s_lens.z + U.s_fb.w * 0.6 + U.s_fb2.x * 0.3) * 0.006;
    vec3 c;
    if (ca > 1e-5) {
        vec2 off = (suv - 0.5) * ca * (0.5 + 2.0 * r2);
        c = vec3(textureLod(color_tex, suv + off, 0.0).r, textureLod(color_tex, suv, 0.0).g, textureLod(color_tex, suv - off, 0.0).b);
    } else {
        c = textureLod(color_tex, suv, 0.0).rgb;
    }
    c = max(c, vec3(0.0));

    // Bloom + dirt + flare (scene units).
    if (pc.u0.x != 0u) {
        vec3 b = textureLod(bloom_tex, suv, 0.0).rgb / max(float(pc.u0.z), 1.0);
        float bi = U.s_bloom.x;
        // Death sequence blur (docs/REVIVE.md): the bloom chain is the blurred scene; stronger at the edges.
        float db = U.s_fb3.y;
        if (db > 0.0) c = mix(c, b, clamp(db * (0.45 + 0.55 * smoothstep(0.0, 0.9, sqrt(r2))), 0.0, 0.9));
        // Look: a soft threshold (exposed scene units; restrained looks keep the bloom off the
        // shadows) and a tint; halation = a red-orange glow where the wide bloom is bright.
        float thr = U.s_look.y;
        float bw = thr > 0.0 ? smoothstep(thr * 0.5, thr * 1.5, luma(b) * expo) : 1.0;
        c = mix(c, b * U.s_look2.rgb, bi * bw);
        if (U.s_look.z > 0.0) c += vec3(1.0, 0.32, 0.12) * max(luma(b) - 0.8 / expo, 0.0) * U.s_look.z * 0.5;
        if (U.s_bloom.y > 0.0) c += b * textureLod(dirt_tex, uv, 0.0).rgb * (U.s_bloom.y * bi * 8.0);
    }
    if (pc.u0.y != 0u) {
        vec3 f = textureLod(flare_tex, uv, 0.0).rgb;
        c += f * (1.0 + textureLod(dirt_tex, uv, 0.0).rgb * U.s_bloom.y * 4.0);
    }

    c *= expo;

    // Vignette (natural cos^4-like falloff), deepened by low health and sprint.
    float vr = sqrt(r2) / sqrt(0.25 * (aspect * aspect + 1.0));   // 0 centre .. 1 corner
    float pulse = 0.5 + 0.5 * sin(time * 5.5);
    float vig_base = U.s_lens.w + U.s_fb2.x * 0.2;
    float vig = vig_base + U.s_fb.y * (0.35 + 0.25 * pulse);
    float vm = smoothstep(0.25, 1.1, vr);
    float vy = luma(c);
    c *= 1.0 - clamp(vig, 0.0, 1.0) * vm;
    // The low-health part of the vignette takes the look's colour (black = plain darkening).
    c += U.s_look4.rgb * vy * (clamp(vig, 0.0, 1.0) - clamp(vig_base, 0.0, 1.0)) * vm;

    c = white_balance(c, U.s_tm.y, U.s_tm.z);
    // Contrast in log space around mid grey, saturation around luminance.
    c = 0.18 * pow(max(c, vec3(0.0)) / 0.18 + 1e-6, vec3(U.s_lift.w));
    float y = luma(c);
    float sat = U.s_tm.w * (1.0 - U.s_fb.y * 0.6 * (0.7 + 0.3 * pulse)) * (1.0 - U.s_fb2.w);
    c = max(mix(vec3(y), c, sat), vec3(0.0));

    // Damage: red edge tint; underwater: blue-green absorption; night vision: green amplified mono.
    float edge = smoothstep(0.35, 1.0, vr);
    c = mix(c, c * U.s_look3.rgb + vec3(0.12 * U.s_look3.r / 1.3, 0.0, 0.0) * y, U.s_fb.x * (0.25 + 0.75 * edge));
    c = mix(c, c * vec3(0.35, 0.8, 0.9) + vec3(0.0, 0.02, 0.03), uw);
    if (U.s_fb2.z > 0.0) {
        float n = blue_noise(noise_tex, p).r - 0.5;
        float l = luma(c) * 6.0 + n * 0.08;
        vec3 nv = vec3(0.25, 1.0, 0.3) * l * (1.0 - 0.5 * smoothstep(0.5, 1.0, vr));
        c = mix(c, nv, U.s_fb2.z);
    }
    c *= U.s_fb_tint.rgb;

    vec3 o;
    bool look = U.s_look.x > 0.5;
    if (hdr) {
        // Shoulder at max nits: tonemap in the paper-white normalised range scaled by max / paper.
        float pw = U.s_out.y, mx = max(U.s_out.z, pw);
        o = (look ? look_lut(look_tex, c * (pw / mx)) : tonemap(c * (pw / mx))) * (mx / pw);   // 1.0 = paper white
    } else {
        o = look ? look_lut(look_tex, c) : tonemap(c);
    }

    // Lift / gamma / gain (display referred), LUT and colour-blind filter on encoded values.
    vec3 lift = U.s_lift.rgb, gam = max(U.s_gamma.rgb, vec3(0.05)), gain = U.s_gain.rgb;
    if (!hdr) {
        o = gain * (o + lift * (1.0 - o));
        o = pow(max(o, vec3(0.0)), 1.0 / gam);
        vec3 e = srgb_encode(clamp(o, 0.0, 1.0));
        if (U.s_gamma.w > 0.0) {
            vec3 l = textureLod(lut_tex, e * (31.0 / 32.0) + 0.5 / 32.0, 0.0).rgb;
            e = mix(e, l, U.s_gamma.w);
        }
        int cb = int(U.s_gain.w + 0.5);
        if (cb > 0) e = colorblind_correct(e, cb);
        // User brightness / gamma (settings menu) on the encoded signal.
        e = pow(clamp(e * U.s_out.w, 0.0, 1.0), vec3(1.0 / max(U.s_fb_tint.w, 0.2)));
        o = srgb_decode(e);
        o = mix(o, vec3(1.0), clamp(U.s_fb.z, 0.0, 1.0));   // flashbang
    } else {
        o = gain * (o + lift * (1.0 - min(o, vec3(1.0))));
        o = pow(max(o, vec3(0.0)), 1.0 / gam);
        o *= U.s_out.w;
        o = mix(o, vec3(4.0), clamp(U.s_fb.z, 0.0, 1.0));
        o = REC709_TO_2020 * o * (U.s_out.y / 10000.0);
    }
    // Look letterbox (s_look.w = target aspect): bars top and bottom, 1 px soft edge.
    if (U.s_look.w > 0.0 && aspect < U.s_look.w) {
        float bar = 0.5 * (1.0 - aspect / U.s_look.w), px = 1.0 / float(sz.y);
        o *= smoothstep(bar - px, bar, uv.y) * smoothstep(bar - px, bar, 1.0 - uv.y);
    }
    o *= 1.0 - clamp(U.s_fb3.x, 0.0, 1.0);   // death sequence: the cut to black
    imageStore(dst, p, vec4(o, 1.0));
}
