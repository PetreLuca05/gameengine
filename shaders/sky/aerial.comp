#version 450
// Aerial perspective froxels (32 x 32 x 32, the screen x a quadratic depth distribution up to
// SK.ap.x metres): in-scattering of the sun and the moon and the mean transmittance from the
// camera, applied to geometry in fog_apply (with the volumetric fog froxels). One thread per
// column marches through the slices.
#extension GL_GOOGLE_include_directive : require
#include "sky_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D trans_lut;
layout(set = 0, binding = 1) uniform sampler2D ms_lut;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image3D out_ap;

vec3 transmittance(float r, float mu) { return textureLod(trans_lut, trans_uv(r, mu), 0.0).rgb; }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= 32 || p.y >= 32) return;
    vec2 uv = (vec2(p) + 0.5) / 32.0;
    vec4 wp = U.inv_view_proj * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 rd = normalize(wp.xyz / wp.w - U.cam_pos.xyz);
    vec3 ro = planet_pos();
    vec3 ls[2] = vec3[2](normalize(SK.sun_dir.xyz), normalize(SK.moon_dir.xyz));
    float le[2] = float[2](light_weight(0), light_weight(1));
    float cph[2];
    for (int k = 0; k < 2; k++) cph[k] = dot(rd, ls[k]);
    float km = SK.ap.y;   // world metres -> atmosphere km (x aerial scale)
    vec3 L = vec3(0.0), thr = vec3(1.0);
    float t = 0.0;
    for (int s = 0; s < 32; s++) {
        float f = float(s + 1) / 32.0;
        float t_end = SK.ap.x * f * f * km;
        // One step per slice (the slices are already quadratic in depth).
        for (int j = 0; j < 1; j++) {
            float t1 = t_end;
            float dt = t_end - t;
            vec3 x = ro + rd * (t1 - 0.5 * dt);
            float h = max(length(x), R_BOTTOM + 0.0005);
            Medium m = medium(h - R_BOTTOM);
            vec3 up = x / length(x);
            vec3 S = vec3(0.0);
            for (int k = 0; k < 2; k++) {
                if (le[k] <= 0.0) continue;
                float mu_l = dot(up, ls[k]);
                float earth = ray_sphere(x, ls[k], R_BOTTOM) > 0.0 ? 0.0 : 1.0;
                vec3 tl = transmittance(h, mu_l) * earth;
                vec3 ms = textureLod(ms_lut, ms_uv(h, mu_l), 0.0).rgb;
                S += le[k] * ((m.scat_ray * phase_rayleigh(cph[k]) + vec3(m.scat_mie) * phase_mie(cph[k])) * tl + ms * (m.scat_ray + vec3(m.scat_mie)));
            }
            vec3 st = exp(-m.ext * dt);
            vec3 ext = max(m.ext, vec3(1e-7));
            L += thr * (S - S * st) / ext;
            thr *= st;
        }
        t = t_end;
        imageStore(out_ap, ivec3(p, s), vec4(sanitize(L), dot(thr, vec3(1.0 / 3.0))));
    }
}
