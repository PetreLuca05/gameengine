#version 450
// Cloud map (512 x 512, the upper hemisphere in a rotated octahedral mapping): the 2D cloud layer
// as seen from the camera this frame, lit by the sun / moon through the atmosphere (earth shadow,
// a short march towards the light, silver lining) plus sky ambient, faded and hazed with
// distance. Premultiplied: rgb = colour x coverage, a = coverage. The sky and the environment
// sample it instead of evaluating the noise per pixel.
#extension GL_GOOGLE_include_directive : require
#include "sky_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D trans_lut;
layout(set = 0, binding = 2) uniform sampler2D skyview_lut;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D out_clouds;

vec3 transmittance(float r, float mu) { return textureLod(trans_lut, trans_uv(r, mu), 0.0).rgb; }
vec3 sky_lut(vec3 dir) {
    float r = length(planet_pos());
    vec2 uv = skyview_uv(r, dir);
    uv.y = clamp(uv.y, 0.5 / float(SKYVIEW_SIZE.y), 1.0 - 0.5 / float(SKYVIEW_SIZE.y));
    return textureLod(skyview_lut, uv, 0.0).rgb;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= CLOUD_MAP || p.y >= CLOUD_MAP) return;
    vec3 dir = hemi_dir((vec2(p) + 0.5) / float(CLOUD_MAP));
    vec4 o = vec4(0.0);
    vec2 xz;
    float dist;
    if (cloud_hit(dir, xz, dist)) {
        float d = cloud_density(xz, 5);
        float fade = (1.0 - smoothstep(12000.0, 45000.0, dist)) * smoothstep(0.012, 0.06, dir.y);
        d *= fade * SK.clouds2.x;
        if (d > 0.001) {
            vec3 S = normalize(SK.sun_dir.xyz), M = normalize(SK.moon_dir.xyz);
            float rc = R_BOTTOM + SK.clouds.y * 0.001;
            vec3 sun_c = transmittance(rc, S.y) * SK.sun_dir.w * earth_vis(rc, S);
            vec3 moon_c = transmittance(rc, M.y) * SK.moon_dir.w * earth_vis(rc, M);
            float thick = cloud_density(xz + S.xz * 140.0, 3);   // towards the sun
            float beer = exp(-thick * 2.5) * 0.85 + 0.15;
            float cs = max(dot(dir, S), 0.0);
            float silver = 0.25 + 1.2 * pow(cs, 12.0);
            vec3 amb = sky_lut(vec3(0.0, 1.0, 0.0)) * 2.2 + sky_lut(normalize(vec3(dir.x, 0.1, dir.z))) * 0.8;
            vec3 col = (sun_c * beer * silver + moon_c * beer * 0.35) * 0.12 + amb * (0.55 + 0.45 * (1.0 - d));
            float hz = smoothstep(4000.0, 30000.0, dist);
            col = mix(col, sky_lut(normalize(vec3(dir.x, max(dir.y, 0.02), dir.z))), hz * 0.6);
            o = vec4(col * d, d);
        }
    }
    imageStore(out_clouds, p, sanitize4(o));
}
