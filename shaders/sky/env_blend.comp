#version 450
// The environment the lit shaders sample: the previous complete refilter blended into the latest
// by the phase of the refilter cycle (SK.env.x: 0 at the cycle that completed the latest, 1 four
// frames later), so it moves on continuously with a constant lag of ~5 frames at any clock speed
// and never pops when a refilter completes. Every image bound at this mip level; pc.u0.y = 1 snaps
// to the latest (first frame).
#extension GL_GOOGLE_include_directive : require
#include "sky_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D latest_env;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D cur_env;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D prev_env;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(cur_env);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec4 b = imageLoad(latest_env, p), a = imageLoad(prev_env, p);
    float k = pc.u0.y == 1u ? 1.0 : clamp(SK.env.x, 0.0, 1.0);
    imageStore(cur_env, p, vec4(sanitize(mix(a.rgb, b.rgb, k)), 1.0));
}
