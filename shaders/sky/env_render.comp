#version 450
// Environment (octahedral, 128 x 128) for the lit shaders' ambient (SH irradiance) and specular,
// amortized: a quarter of the rows per frame into the "next" map (SK.env.y = slice). The sky
// view LUT, the clouds (fewer octaves) and below the horizon the ground lit by the sun / moon
// and the sky. The sun / moon discs are left out (the lit shaders add the analytic lights).
#extension GL_GOOGLE_include_directive : require
#include "sky_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D trans_lut;
layout(set = 0, binding = 2) uniform sampler2D skyview_lut;
layout(set = 0, binding = 5) uniform sampler2D clouds_tex;
layout(set = 0, binding = 7) uniform sampler2D cshadow_tex;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D out_env;

vec3 transmittance(float r, float mu) { return textureLod(trans_lut, trans_uv(r, mu), 0.0).rgb; }
vec3 sky_lut(vec3 dir) {
    float r = length(planet_pos());
    vec2 uv = skyview_uv(r, dir);
    uv.y = clamp(uv.y, 0.5 / float(SKYVIEW_SIZE.y), 1.0 - 0.5 / float(SKYVIEW_SIZE.y));
    return textureLod(skyview_lut, uv, 0.0).rgb;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y + uint(SK.env.y) * 32u);
    if (p.x >= 128 || p.y >= 128) return;
    vec2 uv = (vec2(p) + 0.5) / 128.0;
    vec3 dir = oct_decode_dir(uv);
    vec3 S = normalize(SK.sun_dir.xyz), M = normalize(SK.moon_dir.xyz);
    vec3 L;
    if (dir.y > -0.02) {
        L = sky_lut(vec3(dir.x, max(dir.y, 0.0), dir.z));
        if (dir.y > 0.0) {
            vec4 cl = textureLod(clouds_tex, hemi_uv(dir), 1.0);
            L = L * (1.0 - cl.a) + cl.rgb;
        }
        L += vec3(0.55, 0.65, 1.0) * SK.cel_z.w;
    } else {
        // Ground: albedo / pi x (direct sun + moon through the atmosphere and the clouds + sky).
        float rg = R_BOTTOM + 0.001;
        float cs = textureLod(cshadow_tex, vec2(0.5), 0.0).r;
        vec3 E = transmittance(rg, S.y) * SK.sun_dir.w * max(S.y, 0.0) + transmittance(rg, M.y) * SK.moon_dir.w * max(M.y, 0.0);
        E *= cs;
        E += (sky_lut(vec3(0.0, 1.0, 0.0)) + sky_lut(normalize(vec3(1.0, 0.25, 0.0))) + sky_lut(normalize(vec3(-1.0, 0.25, 0.0)))) * (PI / 3.0) * 1.6;
        L = SK.ground.rgb / PI * E;
        // The horizon line blends into the ground.
        L = mix(L, sky_lut(vec3(dir.x, 0.0, dir.z)), smoothstep(-0.12, -0.02, dir.y) * 0.6);
    }
    imageStore(out_env, p, vec4(sanitize(L), 1.0));
}
