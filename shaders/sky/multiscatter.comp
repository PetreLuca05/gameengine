#version 450
// Multiple scattering LUT (32 x 32, Hillaire 2020 section 5.5): for a sun zenith angle and a
// height, the second-order isotropic scattering L2 and the transfer f_ms of 64 directions give
// the infinite-order term psi = L2 / (1 - f_ms). Rebuilt when the aerosols move (sky.c): one
// workgroup per texel, one direction per invocation, a shared reduction (64x the parallelism of a
// texel per invocation: the rebuild is cheap enough to follow the aerosols continuously).
#extension GL_GOOGLE_include_directive : require
#include "sky_common.glsl"
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform sampler2D trans_lut;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D out_lut;

vec3 transmittance(float r, float mu) { return trans_eval(textureLod(trans_lut, trans_uv(r, mu), 0.0)); }

shared vec3 s_l[64];
shared vec3 s_f[64];

void main() {
    ivec2 p = ivec2(gl_WorkGroupID.xy);
    uint li = gl_LocalInvocationIndex;
    vec2 uv = (vec2(p) + 0.5) / vec2(MS_SIZE);
    float mu_s = uv.x * 2.0 - 1.0;
    float r = R_BOTTOM + uv.y * (R_TOP - R_BOTTOM) + 0.01;
    vec3 ro = vec3(0.0, r, 0.0);
    vec3 sun = vec3(sqrt(max(1.0 - mu_s * mu_s, 0.0)), mu_s, 0.0);
    const vec3 ground_albedo = vec3(0.3);
    const int SQ = 8;
    int a = int(li) / SQ, b = int(li) % SQ;
    float th = PI * (float(a) + 0.5) / float(SQ);
    float ph = acos(1.0 - 2.0 * (float(b) + 0.5) / float(SQ));
    vec3 rd = vec3(cos(th) * sin(ph), cos(ph), sin(th) * sin(ph));
    float t_ground = ray_sphere(ro, rd, R_BOTTOM);
    float t_top = ray_sphere(ro, rd, R_TOP);
    float t_max = t_ground > 0.0 ? t_ground : t_top;
    vec3 l = vec3(0.0), f = vec3(0.0);
    if (t_max > 0.0) {
        const int N = 20;
        float dt = t_max / float(N);
        vec3 thr = vec3(1.0);
        for (int i = 0; i < N; i++) {
            vec3 x = ro + rd * (float(i) + 0.5) * dt;
            float h = length(x);
            Medium m = medium(h - R_BOTTOM);
            vec3 up = x / h;
            float mu_l = dot(up, sun);
            float earth = ray_sphere(x, sun, R_BOTTOM) > 0.0 ? 0.0 : 1.0;
            vec3 t_sun = transmittance(h, mu_l) * earth;
            vec3 scat = m.scat_ray + vec3(m.scat_mie);
            vec3 S = scat * t_sun / (4.0 * PI);   // isotropic phase
            vec3 st = exp(-m.ext * dt);
            vec3 ext = max(m.ext, vec3(1e-7));
            l += thr * (S - S * st) / ext;
            f += thr * (scat - scat * st) / ext;
            thr *= st;
        }
        if (t_ground > 0.0) {
            vec3 x = ro + rd * t_ground;
            vec3 up = normalize(x);
            float ndl = max(dot(up, sun), 0.0);
            l += thr * transmittance(R_BOTTOM, dot(up, sun)) * ndl * ground_albedo / PI;
        }
    }
    s_l[li] = l;
    s_f[li] = f;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (li < s) {
            s_l[li] += s_l[li + s];
            s_f[li] += s_f[li + s];
        }
        barrier();
    }
    if (li == 0u) {
        float w = 1.0 / float(SQ * SQ);
        vec3 psi = s_l[0] * w / max(vec3(1.0) - s_f[0] * w, vec3(1e-4));
        imageStore(out_lut, p, vec4(psi, 1.0));
    }
}
