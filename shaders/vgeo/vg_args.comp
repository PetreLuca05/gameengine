#version 450
// Indirect dispatch args from a counter (one thread): args[out].xyz = groups of ceil(n / div), split
// over y past 65535. a[0] divisor, a[1] counter to reset + 1, a[2] counter to copy from + 1, a[3]
// copy destination, a[4] cap on the source count (0 = none).
#extension GL_GOOGLE_include_directive : require
#define VG_COMPUTE
#include "vgeo_common.glsl"
layout(local_size_x = 1) in;
void main() {
    uint n = ctr.n[pc.in_region];
    if (pc.a[4] != 0u) n = min(n, pc.a[4]);
    uint g = (n + pc.a[0] - 1u) / pc.a[0];
    uint y = (g + 65534u) / 65535u;
    ctr.args[pc.out_region] = uvec4(min(g, 65535u), max(y, 1u) * uint(g > 0u), 1u, n);
    if (g == 0u) ctr.args[pc.out_region].x = 0u;
    if (pc.a[2] != 0u) ctr.n[pc.a[3]] = ctr.n[pc.a[2] - 1u];
    if (pc.a[1] != 0u) ctr.n[pc.a[1] - 1u] = 0u;
}
