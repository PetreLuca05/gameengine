#version 450
// Pass 1, one thread per placement cell: frustum + last frame's Hi-Z. Visible cells with <= 32
// instances test them inline (vg_instance), larger ones go to cell list region 0 (a workgroup each);
// occluded cells go to region 1 (re-tested in pass 2).
#extension GL_GOOGLE_include_directive : require
#include "vgeo_common.glsl"
#include "vg_expand.glsl"
layout(local_size_x = 64) in;
// a[0] = 0: pass 1 over every cell; a[0] = 1: pass 2 over the cells pass 1 found occluded (cell list
// region 1), large ones listed again in region 0 (counter VGN_CELLS_P2).
void main() {
    uint cap = V.caps1.x, i;
    if (pc.a[0] == 0u) {
        i = gl_GlobalInvocationID.x;
        if (i >= V.counts.x) return;
    } else {
        uint j = vg_flat_group() * 64u + gl_LocalInvocationID.x;
        if (j >= min(ctr.n[VGN_CELLS_OCC], cap)) return;
        i = cell_list[cap + j];
    }
    VgCell c = cells[i];
    vec4 s = vec4((c.mn + c.mx) * 0.5, length(c.mx - c.mn) * 0.5);
    if (!vg_frustum(s)) return;
    if (vg_occluded(s)) {
        if (pc.pass == 1u) {
            uint k = vg_append(VGN_CELLS_OCC, cap);
            if (k != 0xFFFFFFFFu) cell_list[cap + k] = i;
        }
        return;
    }
    // Small cells (most of them): their instances right here; large ones get a workgroup each.
    if (c.count <= 32u) {
        for (uint j = 0u; j < c.count; j++) vg_instance(c.first + j, pc.out_region);
        return;
    }
    uint k = vg_append(pc.pass == 1u ? VGN_CELLS_VIS : VGN_CELLS_P2, cap);
    if (k != 0xFFFFFFFFu) cell_list[k] = i;
}
