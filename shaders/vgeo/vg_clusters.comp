#version 450
// Cluster selection and culling. a[0] = 0: one thread per cluster candidate of region in_region
// (instance, group << 4 | cluster): cluster c of group g is selected when g's parent error projects
// above the threshold (tested at the leaf) and c's own error does not, or c's child group is not
// resident.
// Then frustum, backface cone and Hi-Z on its culling sphere, and SW (< sw_px across) / HW
// classification. a[0] = 1 (pass 2): re-tests pass 1's occluded clusters against this frame's Hi-Z.
#extension GL_GOOGLE_include_directive : require
#define VG_COMPUTE
#include "vgeo_common.glsl"
layout(local_size_x = 64) in;

vec3 oct8(uint v) {
    vec2 f = vec2(float(v & 0xFFu), float((v >> 8) & 0xFFu)) / 255.0 * 2.0 - 1.0;
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

uint cluster_word(uint slot, uint ci) { return slot * VG_PAGE_WORDS + 4u + ci * 16u; }

void emit(uint inst, VgXf x, uint slot, uint ci, bool retest) {
    uint w = cluster_word(slot, ci);
    vec4 cs = vg_world_sphere(x, uintBitsToFloat(uvec4(pool[w], pool[w + 1u], pool[w + 2u], pool[w + 3u])));
    if (!retest) {
        if (!vg_frustum(cs)) return;
        uint cone = pool[w + 9u];
        uint cflags = cone >> 24;
        if ((cflags & (VGC_NO_CONE | VGC_TWO_SIDED)) == 0u && (vg_flags() & (VGV_NO_CONE | VGV_ORTHO)) == 0u) {
            vec3 axis = vg_qrot(x.rot, oct8(cone & 0xFFFFu));
            float cutoff = float(int(cone << 8) >> 24) / 127.0 + 0.02;   // + margin for the 8-bit axis
            vec3 d = cs.xyz - V.cam_pos.xyz;
            if (dot(d, axis) >= cutoff * length(d) + cs.w) return;
        }
    }
    if (vg_occluded(cs)) {
        if (pc.pass == 1u) {
            uint k = vg_append(VGN_CL_OCC, V.caps0.w);
            if (k != 0xFFFFFFFFu) occluded[k] = uvec2(inst, slot << VG_CLUSTER_BITS | ci);
        }
        return;
    }
    if (retest) atomicAdd(ctr.n[VGN_CL_P2], 1u);
    bool sw = vg_project_size(cs) < V.params.y;
    uint cap = V.caps0.z;
    uint k = vg_append(sw ? VGN_SW : VGN_HW, cap);
    if (k == 0xFFFFFFFFu) return;
    visible[(sw ? cap : 0u) + k] = uvec2(inst, slot << VG_CLUSTER_BITS | ci);
    atomicAdd(ctr.n[VGN_TRIS], (pool[w + 10u] >> 8) & 0xFFu);
}

void main() {
    if (pc.a[0] == 1u) {
        uint i = vg_flat_group() * 64u + gl_LocalInvocationID.x;
        if (i >= min(ctr.n[VGN_CL_OCC], V.caps0.w)) return;
        uvec2 o = occluded[i];
        emit(o.x, vg_instance_xf(o.x), o.y >> VG_CLUSTER_BITS, o.y & ((1u << VG_CLUSTER_BITS) - 1u), true);
        return;
    }
    uint gcap = V.caps0.y;
    uint i = vg_flat_group() * 64u + gl_LocalInvocationID.x;
    if (i >= min(ctr.n[VGN_GROUPS0 + pc.in_region], gcap)) return;
    uvec2 cand = group_items[pc.in_region * gcap + i];
    VgXf x = vg_instance_xf(cand.x);
    VgMesh m = meshes[x.mesh];
    VgGroup gr = groups[cand.y >> 4];
    uint slot = page_table[m.page_base + gr.page];
    uint ci = (gr.first_count & 0xFFFFu) + (cand.y & 15u), w = cluster_word(slot, ci);
    vec4 lod = vg_world_sphere(x, uintBitsToFloat(uvec4(pool[w + 4u], pool[w + 5u], pool[w + 6u], pool[w + 7u])));
    float err = uintBitsToFloat(pool[w + 8u]);
    uint child = pool[w + 12u];
    bool own_fine = vg_project_error(lod, err * x.scale) <= V.params.x;
    bool child_missing = child != 0xFFFFFFFFu && page_table[m.page_base + groups[m.group_base + child].page] == 0xFFFFFFFFu;
    if (!(own_fine || child_missing)) return;
    atomicAdd(ctr.n[VGN_CLUSTERS_SELECTED], 1u);
    emit(cand.x, x, slot, ci, false);
}
