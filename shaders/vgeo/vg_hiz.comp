#version 450
// Occlusion Hi-Z (farthest depth = MAX, depth 0 = near) at half resolution, power-of-two sized: texel
// x of mip j covers depth pixels [x << (j + 1), (x + 1) << (j + 1)), pixels outside the screen count
// as 0 (never occlude), so there are no odd tails. One workgroup writes 6 levels of a 32 x 32 tile of
// level pc.base (SPD-style, shared memory): a 1080p chain is 2 dispatches.
//   pc.base == 0: level 0 from the source (pc.src 0: depth texture, 1: visibility buffer, depth =
//                 1 - hi 32 bits as float, empty = far; 2: the nearer of both, the renderer's
//                 this-frame Hi-Z over vgeo + the static legacy occluders); pc.base > 0: from level
//                 base - 1 (src image).
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Push { uint base, levels, src, pad; uvec2 src_size; uvec2 base_size; } pc;
layout(set = 0, binding = 0) uniform sampler2D depth_tex;
layout(set = 0, binding = 1, r32f) uniform readonly image2D src_img;
layout(set = 0, binding = 2, r32f) uniform writeonly image2D dst[6];
layout(set = 0, binding = 3) readonly buffer VisBuffer { uint64_t vis[]; };

shared float s[16][16];

float src_at(ivec2 q) {
    if (q.x >= int(pc.src_size.x) || q.y >= int(pc.src_size.y)) return 0.0;
    if (pc.base > 0u) return imageLoad(src_img, q).r;
    if (pc.src == 0u) return texelFetch(depth_tex, q, 0).r;
    uint hi = uint(vis[uint(q.y) * pc.src_size.x + uint(q.x)] >> 32);
    float v = 1.0 - uintBitsToFloat(hi);
    return pc.src == 2u ? min(v, texelFetch(depth_tex, q, 0).r) : v;
}

void store(uint l, ivec2 p, float v) {
    if (l >= pc.levels) return;
    ivec2 sz = max(ivec2(pc.base_size) >> int(l), ivec2(1));
    if (p.x < sz.x && p.y < sz.y) imageStore(dst[l], p, vec4(v));
}

void main() {
    ivec2 t = ivec2(gl_LocalInvocationID.xy);
    ivec2 tile = ivec2(gl_WorkGroupID.xy) * 32;
    // level base: this thread's 2 x 2 texels (each the max of 2 x 2 source texels)
    float m = 0.0;
    for (int j = 0; j < 2; j++)
        for (int i = 0; i < 2; i++) {
            ivec2 p = tile + t * 2 + ivec2(i, j);
            ivec2 q = p * 2;
            float d;
            if (pc.base == 0u && pc.src == 0u) {
                // one gather at the shared corner of the 2 x 2 block (edge texels clamp: the
                // duplicates are already in the footprint)
                vec4 g = textureGather(depth_tex, (vec2(q) + 1.0) / vec2(pc.src_size));
                d = max(max(g.x, g.y), max(g.z, g.w));
                if (q.x >= int(pc.src_size.x) || q.y >= int(pc.src_size.y)) d = 0.0;
            } else {
                d = max(max(src_at(q), src_at(q + ivec2(1, 0))), max(src_at(q + ivec2(0, 1)), src_at(q + ivec2(1, 1))));
            }
            store(0u, p, d);
            m = max(m, d);
        }
    // level base + 1: this thread's own 2 x 2
    store(1u, tile / 2 + t, m);
    s[t.y][t.x] = m;
    // levels base + 2 .. base + 5 through shared memory
    for (uint l = 2u, n = 8u; l < 6u; l++, n >>= 1) {
        barrier();
        float v = 0.0;
        bool act = uint(t.x) < n && uint(t.y) < n;
        if (act) v = max(max(s[t.y * 2][t.x * 2], s[t.y * 2][t.x * 2 + 1]), max(s[t.y * 2 + 1][t.x * 2], s[t.y * 2 + 1][t.x * 2 + 1]));
        barrier();
        if (act) {
            s[t.y][t.x] = v;
            store(l, (tile >> int(l)) + t, v);
        }
    }
}
