#version 450
// Raster indirect args from the visible list counters (one thread), for the range of pc.pass:
// VGA_DRAW_HW = VkDrawIndirectCommand (384 vertices per HW cluster, firstInstance = range start),
// VGA_MESH / VGA_SW = one workgroup per HW / SW cluster, split over y past 65535.
#extension GL_GOOGLE_include_directive : require
#define VG_COMPUTE
#include "vgeo_common.glsl"
#include "vg_decode.glsl"
#include "vg_raster.glsl"
layout(local_size_x = 1) in;

uvec4 wg_args(uint n) {
    uint y = (n + 65534u) / 65535u;
    return n == 0u ? uvec4(0u, 0u, 1u, 0u) : uvec4(min(n, 65535u), y, 1u, n);
}

void main() {
    uvec2 hw = vg_raster_range(false), sw = vg_raster_range(true);
    ctr.args[VGA_DRAW_HW] = uvec4(384u, hw.y - hw.x, 0u, hw.x);
    ctr.args[VGA_MESH] = wg_args(hw.y - hw.x);
    ctr.args[VGA_SW] = wg_args(sw.y - sw.x);
}
