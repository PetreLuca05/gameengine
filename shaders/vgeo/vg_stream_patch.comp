#version 450
// Streaming page-table scatter (src/render/vgeo/vgeo_stream.c): one thread per patch entry
// (global page, slot or ~0) from the staging ring.
layout(local_size_x = 64) in;
layout(push_constant) uniform Push { uint first, count; } pc;
layout(binding = 0) readonly buffer Patches { uvec2 patches[]; };
layout(binding = 1) buffer PageTable { uint page_table[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    uvec2 p = patches[pc.first + i];
    page_table[p.x] = p.y;
}
