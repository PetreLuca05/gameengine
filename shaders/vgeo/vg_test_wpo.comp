#version 450
// Test-only kernel (tests/test_vgeo_foliage.c): the shared vertex path of every raster / shadow /
// resolve stage (vg_vertex_world: instance transform + the material's WPO snippet, wind / time / the
// displacement buffer of the view) on a list of (instance, page slot << 12 | cluster, vertex):
// out[3 i] displaced world position, [3 i + 1] the cluster's world culling sphere, [3 i + 2] the
// instance's world mesh sphere (both WPO-inflated, vg_world_sphere), [3 i] w = the material's WPO id.
// a[0] = item count.
#extension GL_GOOGLE_include_directive : require
#define VG_COMPUTE
#include "vgeo_common.glsl"
#include "vg_decode.glsl"
layout(local_size_x = 64) in;
layout(set = 1, binding = 0) readonly buffer Items { uvec4 items[]; };
layout(set = 1, binding = 1) writeonly buffer Out { vec4 outv[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.a[0]) return;
    uvec4 it = items[i];
    VgXf x = vg_instance_xf(it.x);
    VgMesh m = meshes[x.mesh];
    VgClusterRef r = vg_cluster_ref(it.y);
    VgClusterData c = vg_cluster(r.slot, r.index);
    outv[i * 3u] = vec4(vg_vertex_world(x, c, m, it.z), float(materials[m.material_base + c.material].wpo));
    outv[i * 3u + 1u] = vg_world_sphere(x, c.sphere);
    outv[i * 3u + 2u] = vg_world_sphere(x, m.sphere);
}
