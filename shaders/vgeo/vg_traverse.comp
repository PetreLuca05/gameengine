#version 450
// One BVH level of every instance (level-synchronous, one dispatch per depth below the root, which
// the instance kernels expand): node queue region in_region -> children into region out_region. A node is visited when its sphere is in the frustum,
// its subtree's max parent error still projects above the threshold and (pass 1 / 2) it is not Hi-Z
// occluded; pass 1 occluded nodes go to region 2 (pass 2 seeds). Leaves emit their groups whose
// parent error projects above the threshold as group items (pass 1: region 0, pass 2: region 1) when
// the group's page is resident, else a page request (priority = projected error).
#extension GL_GOOGLE_include_directive : require
#define VG_COMPUTE
#include "vgeo_common.glsl"
#include "vg_expand.glsl"
layout(local_size_x = 64) in;
void main() {
    uint cap = V.caps0.x;
    uint i = vg_flat_group() * 64u + gl_LocalInvocationID.x;
    if (i >= min(ctr.n[VGN_NODEQ0 + pc.in_region], cap)) return;
    uvec2 item = node_queue[pc.in_region * cap + i];
    VgXf x = vg_instance_xf(item.x);
    VgMesh m = meshes[x.mesh];
    VgNode nd = nodes[item.y];
    vec4 s = vg_world_sphere(x, nd.sphere);
    if (!vg_frustum(s)) return;
    float t = V.params.x;
    if (!(vg_project_error(s, nd.max_parent_error * x.scale) > t)) return;
    if (vg_occluded(s)) {
        if (pc.pass == 1u) {
            uint k = vg_append(VGN_NODEQ0 + 2u, cap);
            if (k != 0xFFFFFFFFu) node_queue[2u * cap + k] = item;
            atomicAdd(ctr.n[VGN_NODES_OCC], 1u);
        }
        return;
    }
    atomicAdd(ctr.n[VGN_NODES_VISITED], 1u);
    vg_expand(item.x, x, m, nd, pc.out_region);
}
